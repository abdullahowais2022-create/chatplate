# ─────────────────────────────────────────────────────────────
# TillText environment template. Copy to .env and fill in.
# Never commit real values. On Vercel, set these in Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Public base URL of the app (used to build webhook URLs, links in notifications, QStash callbacks).
# On Vercel you can leave this out: it defaults to https://<your production domain>.
APP_URL="http://localhost:3000"

# PostgreSQL (Supabase / Neon / Railway). Use the pooled URL for DATABASE_URL on serverless.
# DIRECT_URL (optional) is the direct, non-pooled URL; migrations use it when set.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tilltext?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/tilltext?schema=public"

# 32-byte key, base64. Encrypts WhatsApp tokens/app secrets and customer phone numbers at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating it makes existing encrypted values unreadable, so plan a re-encryption if you rotate.
ENCRYPTION_KEY=""
# Separate 32-byte key (base64) used for HMAC lookups (phone hashes) and session token hashing.
HASH_KEY=""

# ── OpenAI ───────────────────────────────────────────────────
# Leave empty to run in heuristic demo mode (no real AI).
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_TRANSCRIBE_MODEL="whisper-1"

# ── Meta WhatsApp Cloud API ─────────────────────────────────
# Per-restaurant credentials (WABA id, phone number id, access token, app secret) are entered in the
# onboarding wizard and stored encrypted in the database. Only the Graph API version is global.
META_GRAPH_API_VERSION="v21.0"

# One-click "Connect with Facebook" for businesses (Meta Embedded Signup). Optional: without these,
# businesses connect manually. Setup steps: docs/WHATSAPP_SETUP.md → "One-click connect".
META_APP_ID=""
META_APP_SECRET=""
META_EMBEDDED_SIGNUP_CONFIG_ID=""
# Verify token for the shared webhook at {APP_URL}/api/webhooks/whatsapp (any long random text)
META_WEBHOOK_VERIFY_TOKEN=""

# ── Queue: Upstash QStash (recommended in production) ───────
# Without QSTASH_TOKEN, jobs run in-process after the webhook responds (fine for local dev).
QSTASH_TOKEN=""
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""

# ── Rate limiting: Upstash Redis (recommended in production) ─
# Without these, an in-memory limiter is used (per server instance only).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Storage: Supabase Storage (voice notes, logos, menu images) ─
# Without these, files are stored in the database (works on Vercel; fine for logos and voice notes).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_PRIVATE_BUCKET="voice-notes"
SUPABASE_PUBLIC_BUCKET="public-media"

# ── Email notifications (optional, via Resend) ───────────────
RESEND_API_KEY=""
EMAIL_FROM="TillText <orders@yourdomain.com>"

# ── Demo mode ────────────────────────────────────────────────
# Shows a "Try the demo" button on the login page (logs into the seeded demo restaurant).
DEMO_MODE="true"

# Shared secret for Vercel Cron to call /api/cron/* (optional maintenance jobs)
CRON_SECRET=""

# Contact email shown on /privacy, /terms and /data-deletion (Meta requires a privacy policy URL)
LEGAL_CONTACT_EMAIL=""
